{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CareerRanks",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "ranks"
  ],
  "properties": {
    "id": {
      "const": "career_ranks"
    },
    "ranks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "display_name_key",
          "min_xp"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "display_name_key": {
            "type": "string",
            "minLength": 1
          },
          "min_xp": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
