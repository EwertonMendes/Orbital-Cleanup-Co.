{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContractDefinition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "display_name_key",
    "description_key",
    "kind",
    "base_pay",
    "perfect_bonus",
    "company_xp",
    "perfect_xp_bonus"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "display_name_key": {"type": "string", "minLength": 1},
    "description_key": {"type": "string", "minLength": 1},
    "kind": {
      "enum": ["cleanup", "full_cleanup", "recovery", "valuable_recovery", "priority_object"]
    },
    "target_percent_range": {
      "type": "array",
      "prefixItems": [
        {"type": "number", "minimum": 1, "maximum": 100},
        {"type": "number", "minimum": 1, "maximum": 100}
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "target_count_range": {
      "type": "array",
      "prefixItems": [
        {"type": "integer", "minimum": 1},
        {"type": "integer", "minimum": 1}
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "target_value_range": {
      "type": "array",
      "prefixItems": [
        {"type": "integer", "minimum": 1},
        {"type": "integer", "minimum": 1}
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "base_pay": {"type": "integer", "minimum": 0},
    "perfect_bonus": {"type": "integer", "minimum": 0},
    "company_xp": {"type": "integer", "minimum": 0},
    "perfect_xp_bonus": {"type": "integer", "minimum": 0}
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"enum": ["cleanup", "full_cleanup"]}}},
      "then": {"required": ["target_percent_range"]}
    },
    {
      "if": {"properties": {"kind": {"enum": ["recovery", "priority_object"]}}},
      "then": {"required": ["target_count_range"]}
    },
    {
      "if": {"properties": {"kind": {"const": "valuable_recovery"}}},
      "then": {"required": ["target_value_range"]}
    }
  ]
}
