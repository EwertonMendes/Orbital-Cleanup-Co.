{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContractDefinition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "display_name_key",
    "kind",
    "target_percent_range"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "display_name_key": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "cleanup",
        "full_cleanup",
        "recovery",
        "valuable_recovery",
        "priority_object"
      ]
    },
    "target_percent_range": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": 1,
          "maximum": 100
        },
        {
          "type": "number",
          "minimum": 1,
          "maximum": 100
        }
      ],
      "minItems": 2,
      "maxItems": 2
    }
  }
}
