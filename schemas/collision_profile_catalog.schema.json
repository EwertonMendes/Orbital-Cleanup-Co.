{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CollisionProfileCatalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "profiles"
  ],
  "properties": {
    "id": {
      "const": "world"
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bounds_radius",
          "parts"
        ],
        "properties": {
          "bounds_radius": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1.5
          },
          "parts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 24,
            "items": {
              "type": "array",
              "minItems": 3,
              "maxItems": 24,
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "prefixItems": [
                  {
                    "type": "number",
                    "minimum": -0.5,
                    "maximum": 0.5
                  },
                  {
                    "type": "number",
                    "minimum": -0.5,
                    "maximum": 0.5
                  }
                ]
              }
            }
          }
        }
      }
    }
  }
}
