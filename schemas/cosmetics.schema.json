{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Orbital Cleanup Co. ship customization",
  "type": "object",
  "required": ["id", "default_loadout", "categories"],
  "properties": {
    "id": {"const": "ship_customization"},
    "default_loadout": {
      "type": "object",
      "required": ["paint", "livery", "decal", "canopy", "body_kit", "engine", "trail", "beam"],
      "properties": {
        "paint": {"type": "string"},
        "livery": {"type": "string"},
        "decal": {"type": "string"},
        "canopy": {"type": "string"},
        "body_kit": {"type": "string"},
        "engine": {"type": "string"},
        "trail": {"type": "string"},
        "beam": {"type": "string"}
      },
      "additionalProperties": false
    },
    "categories": {
      "type": "object",
      "required": ["paint", "livery", "decal", "canopy", "body_kit", "engine", "trail", "beam"],
      "properties": {
        "paint": {"type": "array", "minItems": 1},
        "livery": {"type": "array", "minItems": 1},
        "decal": {"type": "array", "minItems": 1},
        "canopy": {"type": "array", "minItems": 1},
        "body_kit": {"type": "array", "minItems": 1},
        "engine": {"type": "array", "minItems": 1},
        "trail": {"type": "array", "minItems": 1},
        "beam": {"type": "array", "minItems": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
