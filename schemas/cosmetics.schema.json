{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Orbital Cleanup Co. ship customization",
  "type": "object",
  "required": [
    "id",
    "default_loadout",
    "categories"
  ],
  "properties": {
    "id": {
      "const": "ship_customization"
    },
    "default_loadout": {
      "type": "object",
      "required": [
        "paint",
        "livery",
        "decal",
        "canopy",
        "body_kit",
        "engine",
        "trail",
        "beam"
      ],
      "properties": {
        "paint": {
          "type": "string"
        },
        "livery": {
          "type": "string"
        },
        "decal": {
          "type": "string"
        },
        "canopy": {
          "type": "string"
        },
        "body_kit": {
          "type": "string"
        },
        "engine": {
          "type": "string"
        },
        "trail": {
          "type": "string"
        },
        "beam": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "categories": {
      "type": "object",
      "required": [
        "paint",
        "livery",
        "decal",
        "canopy",
        "body_kit",
        "engine",
        "trail",
        "beam"
      ],
      "properties": {
        "paint": {
          "type": "array",
          "minItems": 1
        },
        "livery": {
          "type": "array",
          "minItems": 1
        },
        "decal": {
          "type": "array",
          "minItems": 1
        },
        "canopy": {
          "type": "array",
          "minItems": 1
        },
        "body_kit": {
          "type": "array",
          "minItems": 1
        },
        "engine": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/engineEffect"
          }
        },
        "trail": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/trailPalette"
          }
        },
        "beam": {
          "type": "array",
          "minItems": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "engineEffect": {
      "type": "object",
      "required": [
        "id",
        "display_name_key",
        "unlock_rank",
        "price",
        "trail"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "display_name_key": {
          "type": "string",
          "minLength": 1
        },
        "unlock_rank": {
          "type": "string",
          "minLength": 1
        },
        "price": {
          "type": "integer",
          "minimum": 0
        },
        "trail": {
          "$ref": "#/$defs/propulsionTrailStyle"
        }
      },
      "additionalProperties": false
    },
    "trailPalette": {
      "type": "object",
      "required": [
        "id",
        "display_name_key",
        "unlock_rank",
        "price",
        "palette"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "display_name_key": {
          "type": "string",
          "minLength": 1
        },
        "unlock_rank": {
          "type": "string",
          "minLength": 1
        },
        "price": {
          "type": "integer",
          "minimum": 0
        },
        "palette": {
          "type": "object",
          "required": [
            "trail_tail",
            "trail_mid",
            "trail_head",
            "accent"
          ],
          "properties": {
            "trail_tail": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "trail_mid": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "trail_head": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "accent": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "propulsionTrailStyle": {
      "type": "object",
      "required": [
        "mode",
        "width",
        "lifetime",
        "sample_interval",
        "minimum_sample_distance",
        "max_samples",
        "opacity",
        "preview_length",
        "preview_points",
        "boost_width_bonus",
        "boost_lifetime_bonus",
        "strand_count",
        "strand_spread",
        "strand_width_decay",
        "strand_alpha_decay",
        "wave_amplitude",
        "wave_frequency",
        "animation_speed",
        "pulse_count",
        "jitter_amplitude",
        "angularity"
      ],
      "properties": {
        "mode": {
          "enum": [
            "ribbon",
            "plasma",
            "pulse",
            "spark",
            "comet",
            "shard",
            "mist",
            "dual_helix",
            "prism_fan",
            "phase_rails",
            "gravity_bow",
            "vortex_coil",
            "vector_cascade"
          ]
        },
        "width": {
          "type": "number",
          "minimum": 0.75,
          "maximum": 72
        },
        "lifetime": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 2
        },
        "sample_interval": {
          "type": "number",
          "minimum": 0.005,
          "maximum": 0.2
        },
        "minimum_sample_distance": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 20
        },
        "max_samples": {
          "type": "integer",
          "minimum": 8,
          "maximum": 120
        },
        "opacity": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 1
        },
        "preview_length": {
          "type": "number",
          "minimum": 12,
          "maximum": 520
        },
        "preview_points": {
          "type": "integer",
          "minimum": 8,
          "maximum": 64
        },
        "boost_width_bonus": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "boost_lifetime_bonus": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "strand_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "strand_spread": {
          "type": "number",
          "minimum": 0,
          "maximum": 24
        },
        "strand_width_decay": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 1
        },
        "strand_alpha_decay": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 1
        },
        "wave_amplitude": {
          "type": "number",
          "minimum": 0,
          "maximum": 24
        },
        "wave_frequency": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "animation_speed": {
          "type": "number",
          "minimum": 0,
          "maximum": 16
        },
        "pulse_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "jitter_amplitude": {
          "type": "number",
          "minimum": 0,
          "maximum": 24
        },
        "angularity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    }
  }
}
