{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BiomeDefinition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "display_name_key",
    "palette",
    "visual_profile",
    "environment",
    "salvage_tables",
    "landmarks",
    "modifiers",
    "spawn_rules",
    "obstacles"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "display_name_key": {
      "type": "string",
      "minLength": 1
    },
    "palette": {
      "type": "object",
      "required": [
        "background",
        "nebula",
        "accent"
      ],
      "properties": {
        "background": {
          "type": "string"
        },
        "nebula": {
          "type": "string"
        },
        "accent": {
          "type": "string"
        }
      }
    },
    "salvage_tables": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "landmarks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "modifiers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "spawn_rules": {
      "type": "object",
      "required": [
        "min_spacing",
        "edge_margin",
        "starter_cluster_count",
        "starter_cluster_radius"
      ],
      "properties": {
        "min_spacing": {
          "type": "number",
          "minimum": 0
        },
        "edge_margin": {
          "type": "number",
          "minimum": 0
        },
        "starter_cluster_count": {
          "type": "integer",
          "minimum": 0
        },
        "starter_cluster_radius": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "obstacles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "sprite",
          "weight",
          "collision_radius",
          "scale_min",
          "scale_max"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "sprite": {
            "type": "string",
            "pattern": "^res://assets/"
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "collision_radius": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "scale_min": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "scale_max": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "visual_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_asset",
        "primary_scale",
        "primary_anchor",
        "primary_parallax",
        "primary_rotation_speed",
        "atmosphere_color",
        "atmosphere_strength",
        "shimmer_strength",
        "traffic_count",
        "dust_density",
        "horizon_style",
        "horizon_intensity"
      ],
      "properties": {
        "atmosphere_color": {
          "type": "string"
        },
        "atmosphere_strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "shimmer_strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5
        },
        "traffic_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 24
        },
        "dust_density": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "primary_asset": {
          "type": "string",
          "pattern": "^res://assets/original/(planets|destinations)/.+\\.svg$"
        },
        "primary_scale": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 5
        },
        "primary_anchor": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "primary_parallax": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5
        },
        "primary_rotation_speed": {
          "type": "number",
          "minimum": -0.08,
          "maximum": 0.08
        },
        "horizon_style": {
          "enum": [
            "clear",
            "orbit",
            "rings",
            "dust",
            "nebula",
            "solar",
            "gas",
            "ice",
            "industrial",
            "anomaly"
          ]
        },
        "horizon_intensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "salvage_mass_multiplier",
        "volumes"
      ],
      "properties": {
        "salvage_mass_multiplier": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 2
        },
        "volumes": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "count_range",
              "shape",
              "strength_range",
              "placement",
              "color",
              "secondary_color"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "gravity_well",
                  "safe_corridor",
                  "drift_current",
                  "visibility_pocket",
                  "scanner_interference",
                  "tractor_distortion",
                  "magnetic_zone"
                ]
              },
              "count_range": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 8
                  },
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 8
                  }
                ],
                "minItems": 2,
                "maxItems": 2
              },
              "shape": {
                "enum": [
                  "circle",
                  "box"
                ]
              },
              "strength_range": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number",
                    "minimum": 0.05,
                    "maximum": 1
                  },
                  {
                    "type": "number",
                    "minimum": 0.05,
                    "maximum": 1
                  }
                ],
                "minItems": 2,
                "maxItems": 2
              },
              "radius_range": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number",
                    "minimum": 80,
                    "maximum": 2000
                  },
                  {
                    "type": "number",
                    "minimum": 80,
                    "maximum": 2000
                  }
                ],
                "minItems": 2,
                "maxItems": 2
              },
              "length_range": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number",
                    "minimum": 200,
                    "maximum": 8000
                  },
                  {
                    "type": "number",
                    "minimum": 200,
                    "maximum": 8000
                  }
                ],
                "minItems": 2,
                "maxItems": 2
              },
              "width_range": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number",
                    "minimum": 100,
                    "maximum": 2000
                  },
                  {
                    "type": "number",
                    "minimum": 100,
                    "maximum": 2000
                  }
                ],
                "minItems": 2,
                "maxItems": 2
              },
              "placement": {
                "enum": [
                  "random",
                  "depot"
                ]
              },
              "color": {
                "type": "string"
              },
              "secondary_color": {
                "type": "string"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "shape": {
                      "const": "circle"
                    }
                  }
                },
                "then": {
                  "required": [
                    "radius_range"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "shape": {
                      "const": "box"
                    }
                  }
                },
                "then": {
                  "required": [
                    "length_range",
                    "width_range"
                  ]
                }
              }
            ]
          }
        }
      }
    }
  }
}
