{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SalvageTableDefinition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "entries"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "salvage",
          "weight"
        ],
        "properties": {
          "salvage": {
            "type": "string"
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    }
  }
}
